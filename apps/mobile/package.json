{
  "name": "budget-manager-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "android": "node scripts/android.mjs",
    "android:device": "node scripts/android.mjs --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "bundle": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "build": "npm run bundle",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-tab-routes.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:routes && npm test -- --runInBand",
    "check": "npm run verify"
  },
  "dependencies": {
    "@budget-manager/api-client": "file:../../packages/api-client",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher": false
  }
}
