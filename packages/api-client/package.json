{
  "name": "@budget-manager/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-ts && node scripts/mark-generated.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run generate && npm run format:check && npm run typecheck && npm test",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "js-yaml": "5.5.0"
  },
  "packageManager": "npm@12.2.2"
}
